<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fit_Score_Range</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(Fit_Score__c)) &amp;&amp; (Fit_Score__c &lt; 0 || Fit_Score__c &gt; 100)</errorConditionFormula>
    <errorDisplayField>Fit_Score__c</errorDisplayField>
    <errorMessage>Fit score must be between 0 and 100.</errorMessage>
</ValidationRule>
